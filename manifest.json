{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extensionName__",
  "version": "0.1.0",
  "description": "__MSG_extensionDescription__",
  "permissions": ["activeTab", "tabs", "scripting", "downloads", "offscreen", "clipboardWrite"],
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup.html"
  },
  "commands": {
    "start-picker": {
      "suggested_key": {
        "default": "Ctrl+Shift+A",
        "mac": "Option+Shift+A"
      },
      "description": "__MSG_startPickerCommand__"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
